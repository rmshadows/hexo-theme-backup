<!DOCTYPE html>
<html lang="en">

<!-- Head tag (contains Google-Analytics、Baidu-Tongji)-->
<%- partial('_partial/head') %>

<!-- hack iOS CSS :active style -->

<body ontouchstart="" class="body--home">
    <!-- ThemeColor -->
    <% if (config.themecolor) { %>
    <%- partial('_partial/themecolor') %>
    <% } %>

    <!-- Navigation (contains search)-->
    <%- partial('_partial/nav',{cache: true}) %>

    <!-- Post Header (contains intro-header、signature、wordcount、busuanzi、waveoverlay) -->
    <%- partial('_partial/header',{cache: true}) %>

    <!-- Main Content (Post contains
    Pager、
    tip、
    socialshare、
    gitalk、gitment、disqus-comment、
    Catalog、
    Sidebar、
    Featured-Tags、
    Friends Blog、
    anchorjs、
    ) -->
    <%- body %>

    <!-- Footer (contains ThemeColor、viewer) -->
    <%- partial('_partial/footer',{cache: true}) %>
    
    <!---自定义的代码 所有页面-->
    <% if(config['mouse_clicked']) { %>
        <script type="text/javascript" src="<%= config.root %>js/on_mouse_clicked/<%= config.mouse_clicked.effect %>.js"></script>
    <% } %>

    <!-- Search -->
    <% if (config.search) { %>
    <%- partial('_partial/search') %>
    <% } %>

    <!-- Image to hack wechat -->
    <!-- <img src="<%= config['url'] %><%= config['root'] %>img/icon_wechat.png" width="0" height="0" /> -->
    <!-- Migrate from head to bottom, no longer block render and still work -->

</body>

</html>
