<!-- Artalk / COMMENTS gate -->
<%
  var atkCfg = config.artalk || {};
  var artalkEnabled = !!(atkCfg.url && atkCfg.enable !== false && page.artalk !== false);
  var artalkCollapse = (typeof page.artalk_collapse !== 'undefined')
    ? !!page.artalk_collapse
    : !!atkCfg.collapse;
  var artalkUnlock = (typeof page.artalk_unlock !== 'undefined')
    ? String(page.artalk_unlock || '')
    : String(atkCfg.unlock || '');
  var artalkUnlockHint = (typeof page.artalk_unlock_hint !== 'undefined')
    ? String(page.artalk_unlock_hint || '')
    : String(atkCfg.unlock_hint || '');
  var artalkNeedGate = artalkCollapse || artalkUnlock.length > 0;
%>
<% if (artalkEnabled) { %>
<section id="comments-section" class="comments-section" aria-label="COMMENTS">
  <h5 class="comments-heading">COMMENTS</h5>

  <% if (artalkNeedGate) { %>
  <div id="comments-gate" class="comments-gate">
    <% if (artalkUnlock.length > 0) { %>
    <% if (artalkUnlockHint) { %>
    <p class="comments-gate-hint"><%= artalkUnlockHint %></p>
    <% } %>
    <div class="comments-gate-row">
      <input type="password" id="comments-unlock-input" class="comments-unlock-input" autocomplete="off" placeholder="Access key">
      <button type="button" id="comments-unlock-btn" class="comments-gate-btn">Unlock</button>
    </div>
    <p id="comments-unlock-error" class="comments-unlock-error" hidden>Wrong key.</p>
    <% } else { %>
    <button type="button" id="comments-expand-btn" class="comments-gate-btn">Show COMMENTS</button>
    <% } %>
  </div>
  <% } %>

  <div id="Comments" <% if (artalkNeedGate) { %>hidden<% } %>></div>
</section>

<script>
(function () {
  var cfg = {
    css: <%- JSON.stringify(atkCfg.url + '/dist/Artalk.css') %>,
    js: <%- JSON.stringify(atkCfg.url + '/dist/Artalk.js') %>,
    server: <%- JSON.stringify(atkCfg.url) %>,
    site: <%- JSON.stringify(atkCfg.site || '') %>,
    pageKey: <%- JSON.stringify(page.permalink) %>,
    unlock: <%- JSON.stringify(artalkUnlock) %>,
    needGate: <%= artalkNeedGate ? 'true' : 'false' %>
  };
  var loaded = false;
  var inited = false;

  function loadScript(src) {
    return new Promise(function (resolve, reject) {
      var el = document.createElement('script');
      el.src = src;
      el.onload = function () { resolve(); };
      el.onerror = reject;
      document.head.appendChild(el);
    });
  }

  function ensureArtalk() {
    if (loaded) return Promise.resolve();
    loaded = true;
    if (!document.querySelector('link[data-artalk-css]')) {
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = cfg.css;
      link.setAttribute('data-artalk-css', '1');
      document.head.appendChild(link);
    }
    if (window.Artalk) return Promise.resolve();
    return loadScript(cfg.js);
  }

  function initArtalk() {
    if (inited) return;
    inited = true;
    var box = document.getElementById('Comments');
    if (box) box.hidden = false;
    var gate = document.getElementById('comments-gate');
    if (gate) gate.hidden = true;
    ensureArtalk().then(function () {
      Artalk.init({
        el: '#Comments',
        pageKey: cfg.pageKey,
        pageTitle: '',
        server: cfg.server,
        site: cfg.site
      });
    }).catch(function (e) {
      console.error('COMMENTS load failed', e);
      inited = false;
    });
  }

  if (!cfg.needGate) {
    initArtalk();
    return;
  }

  var unlockBtn = document.getElementById('comments-unlock-btn');
  var expandBtn = document.getElementById('comments-expand-btn');
  var input = document.getElementById('comments-unlock-input');
  var err = document.getElementById('comments-unlock-error');

  function tryUnlock() {
    if (!cfg.unlock) {
      initArtalk();
      return;
    }
    var val = input ? input.value : '';
    if (val === cfg.unlock) {
      if (err) err.hidden = true;
      initArtalk();
    } else if (err) {
      err.hidden = false;
    }
  }

  if (unlockBtn) {
    unlockBtn.addEventListener('click', tryUnlock);
    if (input) {
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') tryUnlock();
      });
    }
  }
  if (expandBtn) {
    expandBtn.addEventListener('click', function () { initArtalk(); });
  }
})();
</script>
<% } %>


<!-- 1. gitalk comment -->
<% if(config['gitalk']){ %>
<!-- gitalk start -->
<!-- Docs:https://github.com/gitalk/gitalk/blob/master/readme-cn.md -->

<div id="gitalk-container"></div>

<!-- <script src="https://cdn.jsdelivr.net/npm/gitalk@1/dist/gitalk.js"></script> -->
<script src="<%= config.root %>js/comment/gitalk.js"></script>

<script>
  var gitalk = new Gitalk({
    clientID: '<%= config.gitalk.clientID %>',
    clientSecret: '<%= config.gitalk.clientSecret %>',
    repo: '<%= config.gitalk.repo %>',
    owner: '<%= config.gitalk.owner %>',
    admin: '<%= config.gitalk.admin %>',
    //proxy: '<%= config.gitalk.proxy %>',
    id: '<%= page.date %>', // Ensure uniqueness and length less than 50
    distractionFreeMode: false, // Facebook-like distraction free mode
    perPage: <%= config.gitalk.perPage %>,
    pagerDirection: '<%= config.gitalk.pagerDirection %>',
    createIssueManually: <%= config.gitalk.createIssueManually %>,
    language: '<%= config.gitalk.language %>'
  });
  gitalk.render('gitalk-container');

  var gtFolded = () => {
    setTimeout(function() {
      let markdownBody = document.getElementsByClassName("markdown-body");
      let list = Array.from(markdownBody);
      list.forEach(item => {
        if (item.clientHeight > 250) {
          item.classList.add('gt-comment-body-folded');
          item.style.maxHeight = '<%= config.gitalk.maxCommentHeight %>px';
          item.title = 'Click to Expand';
          item.onclick = function() {
            item.classList.remove('gt-comment-body-folded');
            item.style.maxHeight = '';
            item.title = '';
            item.onclick = null;
          };
        }
      })
    }, 800);
  }
</script>

<!-- gitalk end -->
<% } %>


<!-- 2. gitment comment -->
<% if(config['gitment']){ %>
<!-- gitment start -->
<!-- Docs:https://github.com/imsun/gitment -->

<div id="blog_comments"></div>
<!-- <link rel="stylesheet" href="https://imsun.github.io/gitment/style/default.css"> <script src="https://imsun.github.io/gitment/dist/gitment.browser.js"></script> -->

<script src="https://cdn.jsdelivr.net/gh/theme-next/theme-next-gitment@1/gitment.browser.js"></script>

<script>
  const myTheme = {
    render(state, instance) {
      const container = document.createElement('div')
      container.lang = "en-US"
      container.className = 'gitment-container gitment-root-container'

      // your custom component
      container.appendChild(instance.renderSomething(state, instance))
      container.appendChild(instance.renderHeader(state, instance))
      container.appendChild(instance.renderEditor(state, instance))
      container.appendChild(instance.renderComments(state, instance))
      container.appendChild(instance.renderFooter(state, instance))
      return container
    },
    renderSomething(state, instance) {
      const container = document.createElement('div')
      container.lang = "en-US"
      container.className = 'hello_visitor'
      if (state.user.login) {
        container.innerText = `Hello ${state.user.login}, Welcome to comment system`
      }
      return container
    }
  }

  const gitment = new Gitment({
    id: '<%= page.date %>', // optional
    owner: '<%= config.gitment.owner %>',
    repo: '<%= config.gitment.repo %>',
    oauth: {
      client_id: '<%= config.gitment.client_id %>',
      client_secret: '<%= config.gitment.client_secret %>'
    },
    desc: '<%= config.gitment.desc %>',
    perPage: '<%= config.gitment.perPage %>',
    maxCommentHeight: '<%= config.gitment.maxCommentHeight %>',
    theme: myTheme,
    // ... For more available options, check out the documentation below
  })

  gitment.render('blog_comments')
  // or gitment.render(document.getElementById('comments')) or document.body.appendChild(gitment.render())
</script>

<!-- gitment end -->
<% } %>


